#!/bin/bash
#SBATCH --job-name=extract_sages_official_test
#SBATCH --account=pmc085
#SBATCH --partition=ondemand-gpu
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=04:00:00
#SBATCH --output=/group/pmc085/hlionar/outputs/cvs-domain-ssl/logs/%x_%j.out
#SBATCH --error=/group/pmc085/hlionar/outputs/cvs-domain-ssl/logs/%x_%j.err

# Extraction only. No probe stage: a probe must never be trained or selected
# against a test cache, which is the whole point of extracting one.
#
# Every flag below is copied from the manifest of the corresponding val cache,
# so verify_protocol will accept the result. Generated by
# scripts/plan_test_extraction.py -- regenerate rather than edit by hand.

set -euo pipefail
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate /group/pmc085/hlionar/conda_envs/cvsssl

ROOT=/group/pmc085/hlionar
cd $ROOT/cvs-domain-ssl
export PYTHONPATH=$PWD


echo; echo "=== dinov2_b / sages / test ==="
python -u scripts/extract_features.py \
  --encoder dinov2_b \
  --dataset sages --split test \
  --dataset-root $ROOT/datasets/SAGES_CVS_Challenge_2024 \
  --manifest-path metadata/sages_frames_official_test.csv \
  --out $ROOT/cache/dinov2_b/sages_official/test \
  --reduction none \
  --batch-size 64 --num-workers 12

echo; echo "=== dinov2_b_adapted / sages / test ==="
python -u scripts/extract_features.py \
  --encoder dinov2_b \
  --dataset sages --split test \
  --dataset-root $ROOT/datasets/SAGES_CVS_Challenge_2024 \
  --manifest-path metadata/sages_frames_official_test.csv \
  --checkpoint $ROOT/outputs/cvs-domain-ssl/ssl/dinov2_b_sages_sparse/encoder_final.pt \
  --out $ROOT/cache/dinov2_b_adapted/sages_official/test \
  --reduction none \
  --batch-size 64 --num-workers 12

echo; echo "=== dinov3_b / sages / test ==="
python -u scripts/extract_features.py \
  --encoder dinov3_b \
  --dataset sages --split test \
  --dataset-root $ROOT/datasets/SAGES_CVS_Challenge_2024 \
  --manifest-path metadata/sages_frames_official_test.csv \
  --out $ROOT/cache/dinov3_b/sages_official/test \
  --reduction none \
  --batch-size 64 --num-workers 12

echo; echo "=== dinov3_b_trainonly / sages / test ==="
python -u scripts/extract_features.py \
  --encoder dinov3_b \
  --dataset sages --split test \
  --dataset-root $ROOT/datasets/SAGES_CVS_Challenge_2024 \
  --manifest-path metadata/sages_frames_official_test.csv \
  --checkpoint $ROOT/outputs/cvs-domain-ssl/ssl/dinov3_b_sages_trainonly/encoder_final.pt \
  --out $ROOT/cache/dinov3_b_trainonly/sages_official/test \
  --reduction none \
  --batch-size 64 --num-workers 12

echo; echo "=== mae_b / sages / test ==="
python -u scripts/extract_features.py \
  --encoder mae_b \
  --dataset sages --split test \
  --dataset-root $ROOT/datasets/SAGES_CVS_Challenge_2024 \
  --manifest-path metadata/sages_frames_official_test.csv \
  --out $ROOT/cache/mae_b/sages_official/test \
  --reduction none \
  --batch-size 64 --num-workers 12

echo; echo "=== mae_b_trainonly / sages / test ==="
python -u scripts/extract_features.py \
  --encoder mae_b \
  --dataset sages --split test \
  --dataset-root $ROOT/datasets/SAGES_CVS_Challenge_2024 \
  --manifest-path metadata/sages_frames_official_test.csv \
  --checkpoint $ROOT/outputs/cvs-domain-ssl/ssl/mae_b_sages_trainonly/encoder_final.pt \
  --out $ROOT/cache/mae_b_trainonly/sages_official/test \
  --reduction none \
  --batch-size 64 --num-workers 12

echo; echo "=== ijepa_h / sages / test ==="
python -u scripts/extract_features.py \
  --encoder ijepa_h \
  --dataset sages --split test \
  --dataset-root $ROOT/datasets/SAGES_CVS_Challenge_2024 \
  --manifest-path metadata/sages_frames_official_test.csv \
  --out $ROOT/cache/ijepa_h/sages_official/test \
  --reduction none \
  --batch-size 64 --num-workers 12

echo; echo "=== vit_sup_b / sages / test ==="
python -u scripts/extract_features.py \
  --encoder vit_sup_b \
  --dataset sages --split test \
  --dataset-root $ROOT/datasets/SAGES_CVS_Challenge_2024 \
  --manifest-path metadata/sages_frames_official_test.csv \
  --out $ROOT/cache/vit_sup_b/sages_official/test \
  --reduction none \
  --batch-size 64 --num-workers 12

echo; echo "done. Do NOT probe against these caches."
