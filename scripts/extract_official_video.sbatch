#!/bin/bash
#SBATCH --job-name=extract_sages_official_test
#SBATCH --account=pmc085
#SBATCH --partition=ondemand-gpu
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=03:00:00
#SBATCH --output=/group/pmc085/hlionar/outputs/cvs-domain-ssl/logs/%x_%j.out
#SBATCH --error=/group/pmc085/hlionar/outputs/cvs-domain-ssl/logs/%x_%j.err

# Extraction only. No probe stage: a probe must never be trained or selected
# against a test cache, which is the whole point of extracting one.
#
# Every flag below is copied from the manifest of the corresponding val cache,
# so verify_protocol will accept the result. Generated by
# scripts/plan_test_extraction.py -- regenerate rather than edit by hand.

set -euo pipefail
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate /group/pmc085/hlionar/conda_envs/cvsssl

ROOT=/group/pmc085/hlionar
cd $ROOT/cvs-domain-ssl
export PYTHONPATH=$PWD


echo; echo "=== videomae_b_base / sages / test ==="
python -u scripts/extract_features.py \
  --encoder videomae_b \
  --dataset sages_clip --split test \
  --dataset-root $ROOT/datasets/SAGES_CVS_Challenge_2024 \
  --manifest-path metadata/sages_frames_official_test.csv \
  --out $ROOT/cache/videomae_b_base/sages_official/test \
  --reduction none \
  --batch-size 32 --num-workers 12

echo; echo "=== videomae_b_adapted / sages / test ==="
python -u scripts/extract_features.py \
  --encoder videomae_b \
  --dataset sages_clip --split test \
  --dataset-root $ROOT/datasets/SAGES_CVS_Challenge_2024 \
  --manifest-path metadata/sages_frames_official_test.csv \
  --checkpoint $ROOT/outputs/cvs-domain-ssl/ssl/videomae_b_sages/encoder_final.pt \
  --out $ROOT/cache/videomae_b_adapted/sages_official/test \
  --reduction none \
  --batch-size 32 --num-workers 12

echo; echo "=== vjepa2_l_base / sages / test ==="
python -u scripts/extract_features.py \
  --encoder vjepa2_l \
  --dataset sages_clip --split test \
  --dataset-root $ROOT/datasets/SAGES_CVS_Challenge_2024 \
  --manifest-path metadata/sages_frames_official_test.csv \
  --model-name facebook/vjepa2-vitl-fpc16-256-ssv2 \
  --out $ROOT/cache/vjepa2_l_base/sages_official/test \
  --reduction none \
  --batch-size 16 --num-workers 12

echo; echo "=== vjepa2_l_adapted / sages / test ==="
python -u scripts/extract_features.py \
  --encoder vjepa2_l \
  --dataset sages_clip --split test \
  --dataset-root $ROOT/datasets/SAGES_CVS_Challenge_2024 \
  --manifest-path metadata/sages_frames_official_test.csv \
  --model-name facebook/vjepa2-vitl-fpc16-256-ssv2 \
  --checkpoint $ROOT/outputs/cvs-domain-ssl/ssl/vjepa2_l_sages/encoder_final.pt \
  --out $ROOT/cache/vjepa2_l_adapted/sages_official/test \
  --reduction none \
  --batch-size 16 --num-workers 12

echo; echo "=== vjepa2_l_lr1e6 / sages / test ==="
python -u scripts/extract_features.py \
  --encoder vjepa2_l \
  --dataset sages_clip --split test \
  --dataset-root $ROOT/datasets/SAGES_CVS_Challenge_2024 \
  --manifest-path metadata/sages_frames_official_test.csv \
  --model-name facebook/vjepa2-vitl-fpc16-256-ssv2 \
  --checkpoint $ROOT/outputs/cvs-domain-ssl/ssl/vjepa2_l_sages_lr1e6/encoder_final.pt \
  --out $ROOT/cache/vjepa2_l_lr1e6/sages_official/test \
  --reduction none \
  --batch-size 16 --num-workers 12

echo; echo "done. Do NOT probe against these caches."
